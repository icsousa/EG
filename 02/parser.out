    (3) formula -> . formula IMPLIES formula
    (4) formula -> . formula EQ formula
    (5) formula -> . NOT formula
    (6) formula -> . ( formula )
    (7) formula -> . ID
    (8) formula -> . TRUE
    (9) formula -> . FALSE

    NOT             shift and go to state 2
    (               shift and go to state 3
    ID              shift and go to state 4
    TRUE            shift and go to state 5
    FALSE           shift and go to state 6

    formula                        shift and go to state 1

