// =====================================================================
//  Sentinela v1.3 — gramática completa (Lark, LALR(1) sem conflitos)
//
//  Convenção de nomes (igual em sentinela.lark, GRAMATICA.md e
//  sentinela_ag.py): inglês, como as palavras reservadas, minúsculas e
//  sem "_" (o LarkAG usa "_" internamente para numerar alternativas).
//  As regras com "?" são inlined pelo Lark; os "-> nome" dão nome aos
//  nós da árvore que o verificador (verificador.py) percorre.
// =====================================================================

// ---------- Programa ----------
start: alert* playbook

// ---------- Alertas (esquemas dos eventos recebidos) ----------
alert: "alert" NAME "{" field* "}"
field: NAME ":" datatype ";"

?datatype: basictype
         | "list" "<" datatype ">"         -> listtype
!basictype: "int" | "bool" | "string" | "ip" | "cidr" | "duration"

// ---------- Playbook (serviço sempre ativo) ----------
playbook: "playbook" NAME "{" vardecl* handler+ "}"

?handler: "on" NAME "as" NAME block        -> onhandler
        | "every" DURATION block           -> everyhandler

// ---------- Instruções ----------
block: "{" stmt* "}"

?stmt: vardecl
     | assign
     | ifstmt
     | forstmt
     | action

vardecl: declkind NAME ":" datatype "=" expr ";"
!declkind: "var" | "secret"
assign: NAME "=" expr ";"
ifstmt: "if" "(" expr ")" block ["else" block]
forstmt: "for" NAME "in" expr block
action: NAME "(" [expr ("," expr)*] ")" ";"

// ---------- Expressões (da menor para a maior precedência) ----------
?expr: expr "or" andexpr                   -> orop
     | andexpr
?andexpr: andexpr "and" notexpr            -> andop
        | notexpr
?notexpr: "not" notexpr                    -> notop
        | relexpr
?relexpr: addexpr relop addexpr            -> comparison
        | addexpr
?addexpr: addexpr addop accessexpr         -> arith
        | accessexpr
?accessexpr: accessexpr "." NAME           -> fieldaccess
           | primary
?primary: NAME                             -> var
        | NAME "(" [expr ("," expr)*] ")"  -> call
        | "(" expr ")"
        | "[" [expr ("," expr)*] "]"       -> listlit
        | INT                              -> intlit
        | STRING                           -> strlit
        | CIDR                             -> cidrlit
        | IP                               -> iplit
        | DURATION                         -> durlit
        | BOOL                             -> boollit

!relop: "==" | "!=" | "<" | ">" | "<=" | ">=" | "in"
!addop: "+" | "-"

// ---------- Terminais ----------
BOOL.2: "true" | "false"
CIDR.5: /\d{1,3}(\.\d{1,3}){3}\/\d{1,2}/
IP.4: /\d{1,3}(\.\d{1,3}){3}/
DURATION.3: /\d+(s|m|h)\b/
INT: /\d+/
STRING: /"[^"]*"/
NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

COMMENT: /#[^\n]*/
%import common.WS
%ignore WS
%ignore COMMENT
