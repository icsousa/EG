
start: dec*

dec: alert_decl
   | playbook

// ---------- Declarações ----------
alert_decl: "alert" NAME "{" field* "}"
field: NAME ":" type ";"

playbook: "playbook" NAME "{" var_decl* handler+ "}"
handler: "on" NAME "as" NAME block

?type: basic_type
     | "list" "<" type ">"           -> list_type
!basic_type: "int" | "bool" | "string" | "ip" | "cidr" | "duration"

// ---------- Instruções ----------
block: "{" stmt* "}"

?stmt: var_decl
     | assign
     | if_stmt
     | for_stmt
     | action

var_decl: decl_kind NAME ":" type "=" expr ";"
!decl_kind: "var" | "secret"
assign: NAME "=" expr ";"
if_stmt: "if" "(" expr ")" block ["else" block]
for_stmt: "for" NAME "in" expr block
action: NAME "(" [expr ("," expr)*] ")" ";"

// ---------- Expressões ----------
?expr: expr "or" and_expr            -> or_
     | and_expr
?and_expr: and_expr "and" not_expr   -> and_
         | not_expr
?not_expr: "not" not_expr            -> not_
         | cmp_expr
?cmp_expr: add_expr cmp_op add_expr  -> cmp
         | add_expr
?add_expr: add_expr add_op atom      -> arith
         | atom
?atom: NAME                          -> var
     | atom "." NAME                 -> field_access
     | NAME "(" [expr ("," expr)*] ")" -> call
     | literal
     | "(" expr ")"
     | "[" [expr ("," expr)*] "]"    -> list_lit

?literal: INT -> int_lit | STRING -> str_lit | CIDR -> cidr_lit
        | IP -> ip_lit | DURATION -> dur_lit | BOOL -> bool_lit

!cmp_op: "==" | "!=" | "<" | ">" | "<=" | ">=" | "in"
!add_op: "+" | "-"

// ---------- Terminais ----------
BOOL.2: "true" | "false"
CIDR.5: /\d{1,3}(\.\d{1,3}){3}\/\d{1,2}/
IP.4: /\d{1,3}(\.\d{1,3}){3}/
DURATION.3: /\d+(s|m|h)\b/
INT: /\d+/
STRING: /"[^"]*"/
NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

COMMENT: /#[^\n]*/
%import common.WS
%ignore WS
%ignore COMMENT
