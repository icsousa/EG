alert port_scan {
  src_ip: ip;
  dest_port: int;
}

playbook com_erros {
  secret token: string = "abc";
  var rede: ip = 10.0.0.0/8;                  # E03: cidr atribuído a ip
  var limite: int = 5;
  var limite: int = 10;                       # E02: redeclaração

  on port_scan as s {
    if (s.dest_prt > limite) {                # E04: campo inexistente
      block_ip(s.src_ip);                     # E06: falta a duração
    }
    block_ip(s.src_ip, 1h);                   # W01: destrutiva fora de if
    log("token = " + token);                  # E07: fuga de segredo
    contador = contador + 1;                  # E01: não declarado
  }

  on ddos as d {                              # E05: alerta não declarado
    log("x");
  }
}
