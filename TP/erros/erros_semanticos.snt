# Demonstração: programa SINTATICAMENTE correto, mas com um erro semântico de cada família
alert port_scan {
  src_ip: ip;
  dest_port: int;
}

playbook com_erros {
  secret token: string = "abc";
  var rede: ip = 10.0.0.0/8;                  # expect: E301   expect: W02
  var limite: int = 5;
  var limite: int = 10;                       # expect: E102

  on port_scan as s {
    if (s.dest_prt > limite) {                # expect: E204
      block_ip(s.src_ip);                     # expect: E402
    }
    block_ip(s.src_ip, 1h);                   # expect: W01
    log("token = " + token);                  # expect: E601
    log("porta " + s.dest_port);              # expect: E302
    contador = contador + 1;                  # expect: E101
  }

  on ddos as d {                              # expect: E201
    log("x");
  }
}
