alert port_scan {
  src_ip: ip;
  dest_port: int;
}

alert sem_handler {                                        
  x: int;
}
playbook p {                                               # expect: W04
  var limite: int = 5;
  var esquecida: int = 0;                                  # expect: W02
  on port_scan as s {
    block_ip(s.src_ip, 1h);                                # expect: W01
    for porta in [22] {
      var limite: int = 10;                                # expect: W03
      log(str(limite + porta));
    }
    if (true) { log("x"); }                                # expect: W05
    if (s.dest_port > limite) { quarantine(s.src_ip); }
  }
  every 1h {
    unblock_ip(10.0.0.0/8);
  }
}
