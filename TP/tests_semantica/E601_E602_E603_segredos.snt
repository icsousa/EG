alert port_scan {
  src_ip: ip;
  dest_port: int;
}

playbook p {
  secret token: string = "abc";
  var copia: string = token;                               # expect: E602
  on port_scan as s {
    log("token=" + token);                                 # expect: E601
    notify("chave " + str(token));                         # expect: E601
    notify("scan de " + str(s.src_ip), token);
    if (token == "abc") { log("x"); }                      # expect: E603
    log(copia);
  }
}
