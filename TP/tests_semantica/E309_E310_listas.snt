alert port_scan {
  src_ip: ip;
  dest_port: int;
}

playbook p {
  var mista: list<int> = [22, "80"];                       # expect: E310
  var vazia: list<int> = [];                               # expect: E310
  on port_scan as s {
    for p in s.dest_port {                                 # expect: E309
      log("x");
    }
    log(str(len(mista)) + str(len(vazia)));
  }
}
