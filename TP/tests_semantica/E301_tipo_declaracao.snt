alert port_scan {
  src_ip: ip;
  dest_port: int;
}

playbook p {
  var rede: ip = 10.0.0.0/8;                       # expect: E301
  var n: int = 0;
  on port_scan as s {
    n = "dez";                                     # expect: E301
    if (s.src_ip == rede) { block_ip(s.src_ip, 1h); }
    log(str(n));
  }
}
