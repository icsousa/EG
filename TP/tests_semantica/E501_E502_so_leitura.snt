alert port_scan {
  src_ip: ip;
  dest_port: int;
}

playbook p {
  secret token: string = "abc";
  on port_scan as s {
    token = "outro";                                       # expect: E501
    s = s;                                                 # expect: E502
    for porta in [22] {
      porta = 80;                                          # expect: E502
    }
    notify("x", token);
  }
}
