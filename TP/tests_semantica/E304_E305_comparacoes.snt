alert port_scan {
  src_ip: ip;
  dest_port: int;
}

playbook p {
  var nome: string = "x";
  on port_scan as s {
    if (s.src_ip > 10.0.0.1) { log("a"); }                 # expect: E304
    if (nome < "z") { log("b"); }                          # expect: E304
    if (s.dest_port == "22") { log("c"); }                 # expect: E305
    if (s.dest_port > 1024 and 1h <= 2h) { log("d"); }
  }
}
